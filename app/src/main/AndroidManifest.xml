<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Emulator apps slot can hand games to (needed to see them on Android 11+). -->
    <queries>
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.mmjr" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="io.recompiled.redream" />
        <!-- every app that has a launcher icon, for Settings > Apps & games -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".SlotApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="slot."
        android:theme="@style/Theme.Slot">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets slot be picked as the home screen on handhelds, like other launcher-style frontends. -->
        <activity-alias
            android:name=".HomeAlias"
            android:exported="true"
            android:label="slot."
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- The emulator runs in its own process so a crashing core can't take the launcher down. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Slot" />
    </application>
</manifest>
